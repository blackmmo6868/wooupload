# Copy file này thành .env và điền thông tin thực
DATABASE_URL=postgresql://woommo:CHANGE_PASSWORD@localhost:5432/woommo
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# WooCommerce store mặc định (breaktees.com)
WC_URL=https://breaktees.com
WC_USERNAME=your_wp_username
WC_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Tên store dùng trong SEO
STORE_NAME=BreakTees

# Upload temp dir
UPLOAD_TMP_DIR=/tmp/woommo_uploads
